# Healthcare RAG System — Environment Variables
# Copy this file to .env and fill in your values.

# --- Required ---
ANTHROPIC_API_KEY=sk-ant-your-key-here

# --- RAG Pipeline (optional — config/retrieval_config.yaml is primary) ---
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
EMBEDDING_MODEL=all-MiniLM-L6-v2
CHROMA_PERSIST_DIR=./data/processed/chroma
TOP_K_VECTOR=5
TOP_K_BM25=5
TOP_K_RERANK=3

# --- API Security (optional — defaults shown) ---
RAG_API_KEY=hrag-dev-key-change-me
RAG_SECRET_KEY=                          # JWT signing key (auto-generated if blank)
RAG_JWT_EXPIRE_MINUTES=60
RAG_CORS_ORIGINS=http://localhost:3000,http://localhost:8504

# --- Evaluation (optional) ---
EVAL_MODEL=claude-sonnet-4-5-20250929

# --- Observability (optional) ---
LANGFUSE_SECRET_KEY=your_langfuse_secret_key
LANGFUSE_PUBLIC_KEY=your_langfuse_public_key
LANGFUSE_HOST=http://localhost:3000
